# Скопируйте этот файл в .env и заполните значения.
# На Bothost эти же переменные задаются в панели «Переменные окружения»,
# файл .env в репозиторий не загружается.

# Telegram
BOT_TOKEN=
# id группы; можно оставить пустым — бот запомнит чат сам
GROUP_CHAT_ID=

# Ваш Telegram id: открывает админ-панель в личных сообщениях
ADMIN_USER_ID=

# Время и ежедневные сводки
TIMEZONE=Europe/Moscow
DAILY_HOUR=9
DAILY_MINUTE=0

# Удалять служебные сообщения (команды, шаги диалогов), оставляя только итог
DELETE_SERVICE_MESSAGES=true
